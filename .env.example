# Strava API app credentials — create one at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Must exactly match the "Authorization Callback Domain" configured on your Strava API app.
# Optional: if unset, it's derived from the incoming request origin + /api/strava/callback.
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Random secret used to encrypt the session cookie holding your Strava tokens.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: your resting heart rate (bpm), used to estimate training load when
# an activity has no Strava Relative Effort score. Defaults to 60.
ATHLETE_RESTING_HR=60
