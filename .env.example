# Postgres connection string. If you use the provided docker-compose.yml as-is,
# this default matches it.
DATABASE_URL="postgresql://calorie:calorie@localhost:5432/calorie_tracker"

# Optional: enables photo scanning on the "New food" page (nutrition labels and
# meal photos). Get a key at https://console.anthropic.com/settings/keys.
# Without it, the rest of the app works fine — the photo scan button just
# shows an error explaining it isn't configured.
ANTHROPIC_API_KEY=

# Optional: which Claude model to use for photo scanning. Defaults to claude-opus-5
# (highest accuracy; uses extended thinking too — see ANTHROPIC_THINKING_BUDGET below).
# Set to claude-sonnet-5 or claude-haiku-4-5-20251001 for cheaper/faster scans.
ANTHROPIC_MODEL=claude-opus-5

# Optional: extended-thinking token budget for photo scans, in tokens. Higher
# lets the model reason more before answering (better accuracy on tricky
# labels/meals), at higher cost per scan. Defaults to 2000.
ANTHROPIC_THINKING_BUDGET=2000
