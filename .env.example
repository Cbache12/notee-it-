# Postgres connection string. If you use the provided docker-compose.yml as-is,
# this default matches it.
DATABASE_URL="postgresql://calorie:calorie@localhost:5432/calorie_tracker"

# Optional: enables photo scanning on the "New food" page (nutrition labels and
# meal photos). Get a key at https://console.anthropic.com/settings/keys.
# Without it, the rest of the app works fine — the photo scan button just
# shows an error explaining it isn't configured.
ANTHROPIC_API_KEY=

# Optional: which Claude model to use for photo scanning. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5
