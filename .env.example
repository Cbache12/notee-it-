# Strava API app credentials — create one at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Must exactly match the "Authorization Callback Domain" configured on your Strava API app.
# Optional: if unset, it's derived from the incoming request origin + /api/strava/callback.
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Random secret used to encrypt the session cookie holding your Strava tokens.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: your resting heart rate (bpm), used to estimate training load when
# an activity has no Strava Relative Effort score. Defaults to 60.
ATHLETE_RESTING_HR=60

# Optional: Google OAuth app credentials for two-way Google Calendar sync
# (read what's already scheduled today, and push the generated plan onto your
# calendar). Create one at https://console.cloud.google.com/apis/credentials
# — enable the "Google Calendar API" on the project first, then create an
# OAuth 2.0 Client ID (type "Web application") and add
# <your-app-url>/api/google/callback as an authorized redirect URI. While the
# OAuth consent screen is in "Testing" mode, add your own Google account as a
# test user. If unset, the app works fine without Google Calendar features.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on your Google OAuth client.
# Optional: if unset, it's derived from the incoming request origin + /api/google/callback.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
